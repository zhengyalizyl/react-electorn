{
    "name": "@magicut-react-demo/desktop",
    "private": true,
    "productName": "magicut-react-demo",
    "version": "1.0.0",
    "description": "妙剪智能视频编辑器 Demo 桌面端",
    "main": ".vite/build/main.js",
    "scripts": {
        "start": "electron-forge start",
        "package": "pnpm run package:mac && pnpm run package:win",
        "package:mac": "electron-forge package --platform darwin",
        "package:win": "electron-forge package --platform win32 --arch x64",
        "make": "pnpm run make:mac && pnpm run make:win",
        "make:mac": "electron-forge make --platform darwin",
        "make:win": "electron-forge make --platform win32 --arch x64",
        "lint": "eslint .",
        "format": "prettier --write . && eslint --fix .",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@electron-forge/cli": "7.10.2",
        "@electron-forge/maker-deb": "7.10.2",
        "@electron-forge/maker-rpm": "7.10.2",
        "@electron-forge/maker-squirrel": "7.10.2",
        "@electron-forge/maker-zip": "7.10.2",
        "@electron-forge/plugin-auto-unpack-natives": "7.10.2",
        "@electron-forge/plugin-fuses": "7.10.2",
        "@electron-forge/plugin-vite": "7.10.2",
        "@electron/fuses": "1.8.0",
        "@tailwindcss/vite": "4.1.15",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@types/electron-squirrel-startup": "1.0.2",
        "@types/node": "22.18.9",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@vitejs/plugin-react": "5.0.4",
        "electron": "38.4.0",
        "jsdom": "30.0.1",
        "tailwindcss": "4.1.16",
        "typescript": "5.9.3",
        "vite": "7.1.12",
        "vitest": "2.1.8"
    },
    "dependencies": {
        "@langchain/langgraph": "^1.4.17",
        "@magicut-react-demo/media-index": "workspace:*",
        "@magicut-react-demo/video-agent": "workspace:*",
        "@magicut-react-demo/video-project": "workspace:*",
        "dotenv": "^17.2.3",
        "electron-squirrel-startup": "1.0.1",
        "lucide-react": "1.46.0",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-router-dom": "7.9.4"
    }
}
