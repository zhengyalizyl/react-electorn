  &quot;content&quot;: &quot;// 音乐面板的数据，合并自 magicut-demo.pen 的两张稿：\n// - frame C1Sck（右侧音乐设置区）：行样式、配色、前 3 首（带作者）\n// - frame m9jWt 的 Recommended Card（o6pBm）：完整的 7 首曲库、风格筛选、「使用中」徽标\n//\n// 两张稿的副信息维度不同：C1Sck 给的是作者，m9jWt 给的是题材。\n// 合并后统一放进 credit 这一栏，没有凭空补过任何一方缺的字段。\n// 接真实曲库前整体替换。\n\n/** 封面渐变色站。C1Sck 的是两段，m9jWt 的是三段，所以收数组而不是定长元组 */\nexport type CoverGradient = readonly string[];\n\nexport interface Track {\n    id: string;\n    name: string;\n    /** 副信息：作者（C1Sck）或题材（m9jWt），取决于哪张稿定义了它 */\n    credit: string;\n    /** 风格徽标原文，格式固定为「风格 · 节奏」 */\n    style: string;\n    duration: string;\n    cover: CoverGradient;\n}\n\nexport const tracks = [\n    {\n        id: &#x27;track-eutopia&#x27;,\n        name: &#x27;Eutopia&#x27;,\n        credit: &#x27;Mika Chen&#x27;,\n        style: &#x27;平静 · 偏慢&#x27;,\n        duration: &#x27;02:01&#x27;,\n        cover: [&#x27;#F05F73&#x27;, &#x27;#8B6AF7&#x27;]\n    },\n    {\n        id: &#x27;track-canon&#x27;,\n        name: &#x27;卡农（经典钢琴版）&#x27;,\n        credit: &#x27;Aiden Lin&#x27;,\n        style: &#x27;平静 · 偏快&#x27;,\n        duration: &#x27;01:43&#x27;,\n        cover: [&#x27;#D9A36F&#x27;, &#x27;#7A5CF2&#x27;]\n    },\n    {\n        id: &#x27;track-daily&#x27;,\n        name: &#x27;通用 日常 平和&#x27;,\n        credit: &#x27;Nova Lab&#x27;,\n        style: &#x27;平静 · 适中&#x27;,\n        duration: &#x27;00:20&#x27;,\n        cover: [&#x27;#E43D30&#x27;, &#x27;#111214&#x27;]\n    },\n    {\n        id: &#x27;track-mikanbako&#x27;,\n        name: &#x27;みかん箱-ひやむぎ、そーめ...&#x27;,\n        credit: &#x27;适合财经题材&#x27;,\n        style: &#x27;欢快 · 偏快&#x27;,\n        duration: &#x27;04:20&#x27;,\n        cover: [&#x27;#F6C453&#x27;, &#x27;#F07A5A&#x27;, &#x27;#8A5CFF&#x27;]\n    },\n    {\n        id: &#x27;track-send-my-love&#x27;,\n        name: &#x27;Send My Love&#x27;,\n        credit: &#x27;适合财经题材&#x27;,\n        style: &#x27;抒情 · 适中&#x27;,\n        duration: &#x27;02:05&#x27;,\n        cover: [&#x27;#E5405A&#x27;, &#x27;#3A1E4A&#x27;, &#x2