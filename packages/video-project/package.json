{
    "name": "@magicut-react-demo/video-project",
    "private": true,
    "version": "1.0.0",
    "description": "VideoProject 工程文件的 schema、校验与读写",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./node": "./src/node.ts"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write . && eslint --fix .",
        "typecheck": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "zod": "4.1.12"
    },
    "devDependencies": {
        "@types/node": "22.18.9",
        "typescript": "5.9.3",
        "vitest": "2.1.8"
    }
}
