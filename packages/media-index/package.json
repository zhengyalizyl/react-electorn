{
    "name": "@magicut-react-demo/media-index",
    "private": true,
    "version": "1.0.0",
    "description": "素材库索引：目录扫描、ffprobe 探测、关键帧抽取、SQLite FTS5 检索",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write . && eslint --fix .",
        "typecheck": "tsc --noEmit",
        "index": "vite-node --options.transformMode.ssr=/.*/ -c vitest.config.ts scripts/index-media.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "node-sqlite3-wasm": "0.8.60"
    },
    "devDependencies": {
        "@types/node": "22.18.9",
        "typescript": "5.9.3",
        "vitest": "2.1.8"
    }
}
