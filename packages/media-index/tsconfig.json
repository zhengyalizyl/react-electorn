{
    "compilerOptions": {
        "target": "ESNext",
        "module": "esnext",
        // Intl.Segmenter 的类型在 es2022.intl 里，中文分词靠它，不能省
        "lib": ["esnext"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        // 与 packages/video-project 保持同一档门禁，不放松
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noEmit": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        // 别名三处同步：这里、vitest.config.ts、将来消费方的构建配置
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "types": ["node"]
    },
    "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
